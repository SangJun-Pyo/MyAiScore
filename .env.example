# Local demo and synthetic examples work without a model key.
MYAISCORE_ENABLE_LIVE=false
ANTHROPIC_API_KEY=
# Set an exact model ID available in your Anthropic account. No implicit default.
ANTHROPIC_MODEL=
# Maximum attempted model calls across all owners per UTC day (not a dollar budget).
MYAISCORE_DAILY_MODEL_CALL_LIMIT=20

# Local development uses .data/ (ignored by Git).
MYAISCORE_DATA_DIR=.data
# Only opt in for a single-process production demo with a persistent volume.
MYAISCORE_ALLOW_FILE_STORE=false

# Recommended production persistence. Run supabase/migrations/*.sql first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Do not prefix secrets with NEXT_PUBLIC_. Never commit a populated .env file.
