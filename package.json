{
  "name": "myaiscore",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-based AI collaboration assessment",
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "node scripts/start.mjs",
    "check:docs": "node scripts/checkDocs.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "ingest": "tsx scripts/ingest.ts",
    "smoke:live": "tsx scripts/ingest.ts --repo https://github.com/octocat/Hello-World",
    "cohort:build": "tsx scripts/buildRepositoryCohort.ts",
    "evaluate:offline": "tsx scripts/evaluateOffline.ts",
    "collect:local": "tsx scripts/collectLocalSession.ts",
    "test:e2e": "playwright test",
    "evaluate": "tsx scripts/evaluateRepository.ts",
    "session:report": "node bin/myaiscore.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "bin": {
    "myaiscore": "bin/myaiscore.mjs"
  }
}
